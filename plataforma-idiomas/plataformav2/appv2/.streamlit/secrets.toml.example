# Copia este archivo como ".streamlit/secrets.toml" y completa los valores.
# NUNCA subas secrets.toml a GitHub (está en .gitignore).

# --- Supabase (proyecto/rama de PRUEBAS mientras se valida) ---
SUPABASE_URL = "https://TU-PROYECTO.supabase.co"
SUPABASE_ANON_KEY = "TU-CLAVE-ANON-O-PUBLISHABLE"
# La app NO necesita la clave service_role. No la pongas aquí.

# --- Google Drive, opción SIN Google Cloud (recomendada): Apps Script del socio comunitario ---
# URL /exec de la aplicación web creada con apps_script/Codigo.gs y la misma clave TOKEN del script.
# Si estas dos líneas existen, se usan antes que cualquier otra opción de Drive.
DRIVE_APPS_SCRIPT_URL = "https://script.google.com/macros/s/XXXX/exec"
DRIVE_APPS_SCRIPT_TOKEN = "MISMA-CLAVE-QUE-EN-EL-SCRIPT"

# --- Google Drive, opciones con Google Cloud (OAuth o cuenta de servicio): carpeta raíz "A+S Idiomas" ---
DRIVE_CARPETA_RAIZ_ID = "ID-DE-LA-CARPETA"
# Carpeta local para archivos "pendientes de subir" si Drive falla (opcional)
PENDIENTES_DIR = ".pendientes_drive"

# --- Google Sheets: libro "A+S Idiomas – Base de datos" compartido con la cuenta de servicio ---
SHEETS_ID = "ID-DEL-LIBRO"

# --- Cuenta de servicio de Google (JSON descargado de Google Cloud, campo por campo) ---
[gcp_service_account]
type = "service_account"
project_id = "TU-PROYECTO-GCP"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "plataforma-idiomas@TU-PROYECTO-GCP.iam.gserviceaccount.com"
client_id = "..."
token_uri = "https://oauth2.googleapis.com/token"

# --- Opción recomendada para Drive: OAuth con tu cuenta Google (lo genera obtener_token_drive.py) ---
# Si este bloque existe, Drive lo usa en vez de la cuenta de servicio.
# [google_oauth]
# client_id = "....apps.googleusercontent.com"
# client_secret = "..."
# refresh_token = "..."
