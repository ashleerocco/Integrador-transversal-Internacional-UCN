# Copia este archivo como ".streamlit/secrets.toml" y completa los valores.
# NUNCA subas secrets.toml a GitHub (está en .gitignore).

# --- Supabase (proyecto/rama de PRUEBAS mientras se valida) ---
SUPABASE_URL = "https://TU-PROYECTO.supabase.co"
SUPABASE_ANON_KEY = "TU-CLAVE-ANON-O-PUBLISHABLE"
# La app NO necesita la clave service_role. No la pongas aquí.

# --- Google Drive: carpeta raíz "A+S Idiomas" compartida con la cuenta de servicio ---
DRIVE_CARPETA_RAIZ_ID = "ID-DE-LA-CARPETA"
# Carpeta local para archivos "pendientes de subir" si Drive falla (opcional)
PENDIENTES_DIR = ".pendientes_drive"

# --- Google Sheets: libro "A+S Idiomas – Base de datos" compartido con la cuenta de servicio ---
SHEETS_ID = "ID-DEL-LIBRO"

# --- Cuenta de servicio de Google (JSON descargado de Google Cloud, campo por campo) ---
[gcp_service_account]
type = "service_account"
project_id = "TU-PROYECTO-GCP"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "plataforma-idiomas@TU-PROYECTO-GCP.iam.gserviceaccount.com"
client_id = "..."
token_uri = "https://oauth2.googleapis.com/token"
